# AgriAgent Assam - Multi-Provider AI API Configuration (.env.example)
# Copy this file to .env and add your API key(s). .env is gitignored.

AGRIAGENT_LLM_PROVIDER=groq
AGRIAGENT_DEFAULT_MODEL=openai/gpt-oss-120b
AGRIAGENT_FAILOVER_PROVIDERS=groq
AGRIAGENT_LLM_TIMEOUT_SEC=30
AGRIAGENT_LLM_MAX_RETRIES=2

# Groq API
GROQ_API_KEY=
GROQ_BASE_URL=[https://api.groq.com/openai/v1](https://api.groq.com/openai/v1)
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Optional Secondary Providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-Agent Model Routing
AGENT1_PROVIDER=groq
AGENT1_MODEL=openai/gpt-oss-20b

AGENT2_PROVIDER=groq
AGENT2_MODEL=openai/gpt-oss-120b

AGENT2B_PROVIDER=groq
AGENT2B_MODEL=openai/gpt-oss-120b

AGENT3_PROVIDER=groq
AGENT3_MODEL=openai/gpt-oss-120b
